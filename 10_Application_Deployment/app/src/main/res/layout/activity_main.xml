<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lab_header"
            android:textColor="@color/secondary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_deployment_app"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/desc_deployment_app"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="18dp"/>

        <!-- Verification Badge Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/badge_bg"
            app:strokeWidth="1dp"
            app:strokeColor="@color/accent_green"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:text="✓"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/badge_text"
                    android:gravity="center"
                    android:layout_marginEnd="12dp"/>

                <TextView
                    android:id="@+id/tvVerificationBanner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="PRODUCTION RELEASE VERIFIED\nInstalled via Signed Release APK on Hardware"
                    android:textColor="@color/badge_text"
                    android:textSize="13sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Build Specifications Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@color/surface"
            app:strokeWidth="1dp"
            app:strokeColor="@color/stroke_color"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/card_title_build_info"
                    android:textColor="@color/primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stretchColumns="1">

                    <TableRow android:layout_marginBottom="6dp">
                        <TextView
                            android:text="@string/label_app_id"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:paddingEnd="12dp"/>
                        <TextView
                            android:id="@+id/tvAppId"
                            android:text="com.example.deploymentapp"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:fontFamily="monospace"/>
                    </TableRow>

                    <TableRow android:layout_marginBottom="6dp">
                        <TextView
                            android:text="@string/label_version_name"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:paddingEnd="12dp"/>
                        <TextView
                            android:id="@+id/tvVersionName"
                            android:text="1.0.0-release"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold"/>
                    </TableRow>

                    <TableRow android:layout_marginBottom="6dp">
                        <TextView
                            android:text="@string/label_version_code"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:paddingEnd="12dp"/>
                        <TextView
                            android:id="@+id/tvVersionCode"
                            android:text="100"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold"/>
                    </TableRow>

                    <TableRow android:layout_marginBottom="6dp">
                        <TextView
                            android:text="@string/label_build_type"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:paddingEnd="12dp"/>
                        <TextView
                            android:id="@+id/tvBuildType"
                            android:text="RELEASE (Optimized)"
                            android:textColor="@color/secondary"
                            android:textSize="13sp"
                            android:textStyle="bold"/>
                    </TableRow>

                    <TableRow>
                        <TextView
                            android:text="@string/label_debug_status"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:paddingEnd="12dp"/>
                        <TextView
                            android:id="@+id/tvDebuggable"
                            android:text="FALSE (Production Hardened)"
                            android:textColor="@color/secondary"
                            android:textSize="13sp"
                            android:textStyle="bold"/>
                    </TableRow>
                </TableLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Cryptographic Certificate Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@color/surface"
            app:strokeWidth="1dp"
            app:strokeColor="@color/stroke_color"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/card_title_crypto_info"
                    android:textColor="@color/primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_cert_algorithm"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/val_cert_algorithm"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_cert_validity"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/val_cert_validity"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_cert_fingerprint"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/tvCertFingerprint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Computing certificate digest..."
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:background="#F8FAFC"
                    android:padding="8dp"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Verification Action Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerifyStatus"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="@string/btn_verify_status"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="10dp"
            app:backgroundTint="@color/primary"/>

    </LinearLayout>
</ScrollView>
